worker: sh -c 'ARGS="--day-of-week ${GROWW_PULSE_SCHEDULE_DAY:-0} --hour ${GROWW_PULSE_SCHEDULE_HOUR:-9} --minute ${GROWW_PULSE_SCHEDULE_MINUTE:-0}"; if [ -n "$EXISTING_GOOGLE_DOC_ID" ]; then ARGS="$ARGS --doc-id $EXISTING_GOOGLE_DOC_ID"; fi; if [ "${GROWW_PULSE_DRY_RUN:-false}" = "true" ]; then ARGS="$ARGS --dry-run"; fi; exec python -m groww_pulse schedule $ARGS'
